# Copia este archivo a .env y rellena valores reales.
# El .env real está en .gitignore y NUNCA se commitea.

NODE_ENV=development
PORT=3000

# Origen del frontend en desarrollo (Vite dev server)
CLIENT_URL=http://127.0.0.1:5173

# Cadena de conexión a MongoDB Atlas o local.
# Formato Atlas: mongodb+srv://USUARIO:PASSWORD@cluster.host/dbname?appName=...
# Formato local: mongodb://127.0.0.1:27017/tienda
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster.example.mongodb.net/tienda?appName=ejemplo

# Secreto para firmar JWT. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=genera-un-secreto-largo-aleatorio-aqui

# Vida del JWT y de la cookie (formato: número + d = días)
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_IN=7d

# Base de datos usada por los tests (opcional; si no existe,
# los tests usan mongodb-memory-server)
# TEST_MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster.example.mongodb.net/tienda_test
